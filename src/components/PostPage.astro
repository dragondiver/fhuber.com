---
import { render } from "astro:content";
import Base from "../layouts/Base.astro";
import { t, paths, formatDate, readingMinutes, type Lang } from "../i18n";
import { slugOf, type Post } from "../posts";

interface Props { lang: Lang; post: Post }
const { lang, post } = Astro.props;
const s = t[lang];
const other: Lang = lang === "de" ? "en" : "de";
const slug = slugOf(post);
const { Content } = await render(post);
---
<Base lang={lang} title={post.data.title} description={post.data.description} alt={paths[other].post(slug)} current="posts">
  <article>
    <header class="article-head wrap">
      <div class="label mono"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time><br />{readingMinutes(post.body)} {s.minutes}</div>
      <div class="body">
        <h1>{post.data.title}</h1>
        <p>{post.data.description}</p>
      </div>
    </header>
    <div class="wrap">
      <div class="prose">
        <Content />
        <hr />
        <p class="mono"><a href={`${paths[lang].home}#beitraege`}>← {s.allPosts}</a></p>
      </div>
    </div>
  </article>
</Base>
