---
import Base from "../layouts/Base.astro";
import { t, paths, projects, formatDate, readingMinutes, type Lang } from "../i18n";
import { postsFor, slugOf } from "../posts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t[lang];
const other: Lang = lang === "de" ? "en" : "de";
const posts = await postsFor(lang);
---
<Base lang={lang} alt={paths[other].home} description={s.heroText}>
  <section class="hero wrap">
    <div class="label mono">fhuber.com</div>
    <div class="body">
      <h1>{s.heroTitle}</h1>
      <p>{s.heroText}</p>
    </div>
  </section>

  <section class="wrap block" id="beitraege" aria-labelledby="h-posts">
    <h2 id="h-posts" class="section-label mono">01 — {s.sectionPosts}</h2>
    {posts.length === 0 && <p>{s.noPosts}</p>}
    <div>
      {posts.map((post) => (
        <article class="post-row">
          <div class="date"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time></div>
          <div class="main">
            <h2><a href={paths[lang].post(slugOf(post))}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
          </div>
          <div class="meta mono">{readingMinutes(post.body)} {s.minutes}{post.data.draft && " · Entwurf"}</div>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap block" id="projekte" aria-labelledby="h-projects">
    <h2 id="h-projects" class="section-label mono">02 — {s.sectionProjects}</h2>
    <div class="projects">
      {projects.map((p, i) => {
        const inner = (
          <>
            <span class="mono">P{i + 1}</span>
            <div><strong>{p.name}</strong><span>{p[lang]}</span></div>
          </>
        );
        return p.url ? <a class="project" href={p.url}>{inner}</a> : <div class="project">{inner}</div>;
      })}
    </div>
  </section>
</Base>
